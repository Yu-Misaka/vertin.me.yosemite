---
import type { CollectionEntry } from "astro:content";
import { site } from "../config/site";
import Cover from "./Cover.astro";
import { getExcerpt } from "../utils/excerpt";

type Props = {
  posts: CollectionEntry<"posts">[];
  currentPage: number;
  totalPages: number;
  prevUrl: string | null;
  nextUrl: string | null;
};

const { posts, currentPage, totalPages, prevUrl, nextUrl } = Astro.props as Props;
---
<div class="wrapper">
  {posts.map((post, index) => {
    const hasImg = Boolean(post.data.cover);
    return (
      <article
        class={`post ${hasImg ? "post--photo post--cover" : "post--text"} post--index main-item`}
        data-ps-post-key={post.id}
        data-protected="false"

      >
        <div class="post-inner">
          {site.show.cardCategory && post.data.category ? (
            <span class="post-cat-vertical">{post.data.category}</span>
          ) : null}

          <header class={`post-item post-header ${hasImg ? "no-bg" : ""}`}>
            <div class="wrapper post-wrapper">
              <div class="avatar post-author">
                <img
                  src={site.author.avatar}
                  alt="作者头像"
                  class="avatar-item avatar-img"
                  width="32" height="32"
                  loading="lazy"
                  decoding="async"
                  fetchpriority="low"
                />
                <span class="avatar-item">{site.author.name}</span>
              </div>
            </div>
          </header>

          {hasImg ? (
            <Cover src={post.data.cover!} eager={index === 0} />
          ) : null}

          <section class="post-item post-body">
            <div class="wrapper post-wrapper">
              <h1 class="post-title">
                <a href={`/posts/${post.id}/`}>{post.data.title}</a>
              </h1>
              <p class="post-excerpt">
                {post.data.description ?? getExcerpt(post.body)}
              </p>
            </div>
          </section>

          <footer class="post-item post-footer">
            <div class="wrapper post-wrapper">
              <div class="meta post-meta">
                <a
                  itemprop="datePublished"
                  href={`/posts/${post.id}/`}
                  class="icon-ui icon-ui-date meta-item meta-date"
                >
                  <span class="meta-count">{post.data.date.toISOString().slice(0, 10)}</span>
                </a>
                <a href={`/posts/${post.id}/#comments`} class="icon-ui icon-ui-comment meta-item meta-comment">
                  暂无评论
                </a>
              </div>
            </div>
          </footer>
        </div>
      </article>
    );
  })}
</div>

<nav class="nav main-pager" data-js="pager">
  <span class="nav-item-alt">第 {currentPage} 页 / 共 {totalPages} 页</span>
  <div class="nav nav--pager">
    {prevUrl ? (
      <a class="prev" href={prevUrl}>上一页</a>
    ) : null}
    <i class="icon-record-outline"></i>
    {nextUrl ? (
      <a class="next" href={nextUrl}>下一页</a>
    ) : null}
  </div>
</nav>

<div class="nav main-lastinfo">
  <span class="nav-item-alt" set:html={site.footerInfo} />
</div>
