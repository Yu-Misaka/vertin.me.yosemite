---
import { getCollection } from "astro:content";
import { site } from "../config/site";
import { imageMarkup } from '../utils/image-markup.mjs';

const current = Astro.props.current ?? "/";
const normalize = (path: string) => path.replace(/\/+$/, '') || '/';
const isActive = (href: string) => normalize(current) === normalize(href);
const aplayer = site.aplayer;
const customCode = await imageMarkup(site.leftSideCustomCode);

const pages = await getCollection("pages");
const pageItems = pages
  .slice()
  .sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999))
  .map((page) => ({
    label: page.data.title,
    href: `/${page.id}`,
    order: page.data.order
  }));

const baseItems = site.navItems ?? [];
const baseHrefSet = new Set(baseItems.map((item) => item.href));
const merged = [...baseItems, ...pageItems.filter((item) => !baseHrefSet.has(item.href))];
const navItems = merged.slice().sort((a, b) => (a.order ?? 999) - (b.order ?? 999));

const aplayerConfig = JSON.stringify({
  theme: aplayer.theme,
  listFolded: aplayer.listFolded,
  listMaxHeight: aplayer.listMaxHeight,
  audio: aplayer.audio
});
---
<header transition:persist="site-header" class="header" data-js="header" data-pagefind-ignore>
  <div class="wrapper header-wrapper header-title">
    <a href={site.logoIndexUrl} class="avatar-link" aria-label={site.author.name}>
      <span class="el-avatar el-avatar--circle avatar-hover-effect">
        <img
          src={site.logoIndex}
          style="object-fit:cover;"
          alt="博主头像"
          width="120"
          height="120"
          data-name="博主名字"
          draggable="false"
          fetchpriority="high"
          decoding="async"
          loading="eager"
        />
      </span>
    </a>
    <div class="header-title">{site.titleIndex}</div>
    <p itemprop="description" class="header-item header-about">{site.description}</p>
    <div class="nav header-item left-side-custom-code" set:html={customCode} />
    <nav class="nav header-item header-nav">
      {navItems.map((item) => (
        <span class={`nav-item${isActive(item.href) ? ' nav-item-current' : ''}`}>
          <a href={item.href} title={item.label} aria-current={isActive(item.href) ? 'page' : undefined}>
            <span>{item.label}</span>
          </a>
        </span>
      ))}
    </nav>
    <div class="theme-toggle-container">
      <button type="button" class="theme-toggle" aria-label="切换主题，当前：跟随系统">
        <span id="theme-icon" class="icon-auto" aria-hidden="true"></span>
      </button>
    </div>
    <div id="theme-status" class="theme-status" role="status" aria-live="polite" aria-atomic="true"></div>
    <div class="nav header-item left-side-custom-code header-spacer">&emsp;</div>
    {aplayer.enabled ? (
      <div class="aplayer-shell" id="aplayer" data-aplayer-config={aplayerConfig}>
      </div>
    ) : null}
  </div>
</header>
