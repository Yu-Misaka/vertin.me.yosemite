---
import { getCollection } from "astro:content";
import { site } from "../config/site";

const current = Astro.props.current ?? "/";
const isActive = (href: string) => (current === href ? " nav-item-current" : "");
const aplayer = site.aplayer;

const pages = await getCollection("pages");
const pageItems = pages
  .slice()
  .sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999))
  .map((page) => ({
    label: page.data.title,
    href: `/${page.slug}`,
    order: page.data.order
  }));

const baseItems = site.navItems ?? [];
const baseHrefSet = new Set(baseItems.map((item) => item.href));
const merged = [...baseItems, ...pageItems.filter((item) => !baseHrefSet.has(item.href))];
const navItems = merged.slice().sort((a, b) => (a.order ?? 999) - (b.order ?? 999));

const aplayerConfig = JSON.stringify({
  theme: aplayer.theme,
  listFolded: aplayer.listFolded,
  listMaxHeight: aplayer.listMaxHeight,
  audio: aplayer.audio
});
---
<header class="header" data-js="header" data-pagefind-ignore>
  <div class="wrapper header-wrapper header-title">
    <a href={site.logoIndexUrl} class="avatar-link" aria-label={site.author.name}>
      <span class="el-avatar el-avatar--circle avatar-hover-effect">
        <img
          src={site.logoIndex}
          style="object-fit:cover;"
          alt="博主头像"
          width="120"
          height="120"
          data-name="博主名字"
          draggable="false"
          fetchpriority="high"
          decoding="async"
          loading="eager"
        />
      </span>
    </a>
    <div class="header-title">{site.titleIndex}</div>
    <p itemprop="description" class="header-item header-about">{site.description}</p>
    <div class="nav header-item left-side-custom-code" set:html={site.leftSideCustomCode} />
    <nav class="nav header-item header-nav">
      {navItems.map((item) => (
        <span class={`nav-item${isActive(item.href)}`}>
          <a href={item.href} title={item.label}>
            <span>{item.label}</span>
          </a>
        </span>
      ))}
    </nav>
    <div class="theme-toggle-container">
      <button class="theme-toggle" onclick="toggleTheme()" aria-label="日夜切换">
        <span id="theme-icon" class="icon-moon-inv"></span>
      </button>
    </div>
    <div style="color:#1d1f20" class="nav header-item left-side-custom-code">&emsp;</div>
    {aplayer.enabled ? (
      <div style="text-align:left" id="aplayer" data-aplayer-config={aplayerConfig}>
        <script is:inline>{`
          window.__aplayerConfig = {
            theme: ${JSON.stringify(aplayer.theme)},
            listFolded: ${JSON.stringify(aplayer.listFolded)},
            listMaxHeight: ${JSON.stringify(aplayer.listMaxHeight)},
            audio: ${JSON.stringify(aplayer.audio)}
          };
          if (typeof window.__initAPlayer === 'function') {
            window.__initAPlayer();
          }
        `}</script>
        <style>
          {`
            .aplayer .aplayer-list {
              max-height: 96px !important;
              overflow-y: auto !important;
            }
          `}
        </style>
      </div>
    ) : null}
  </div>
</header>
