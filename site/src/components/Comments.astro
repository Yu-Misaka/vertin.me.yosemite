---
import { site } from "../config/site";

const envId = site.comments?.provider === "twikoo" ? site.comments.envId : "";
const enabled = Boolean(envId);
---
{enabled ? (
  <div id="comments" class="cf" data-pagefind-ignore>
    <h1 class="comment-title">评论</h1>
    <div id="tcomment"></div>
    <script
      is:inline
    >{`
      window.__twikooEnvId = ${JSON.stringify(envId)};
      window.__initTwikoo = function () {
        if (!window.twikoo || !window.__twikooEnvId) return;
        window.twikoo.init({
          envId: window.__twikooEnvId,
          el: "#tcomment",
          path: window.location.pathname
        });
      };
      document.addEventListener("astro:page-load", function () {
        window.__initTwikoo && window.__initTwikoo();
      });
      document.addEventListener("astro:after-swap", function () {
        window.__initTwikoo && window.__initTwikoo();
      });
    `}</script>
    <script
      defer
      src="https://cdn.jsdelivr.net/npm/twikoo@1.6.44/dist/twikoo.all.min.js"
      onload="window.__initTwikoo && window.__initTwikoo()"
    ></script>
  </div>
) : (
  <div>
    <h3>评论区已关闭</h3>
  </div>
)}
