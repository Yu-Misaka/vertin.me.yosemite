---
import { site } from "../config/site";

const envId = site.comments?.provider === "twikoo" ? site.comments.envId : "";
const enabled = Boolean(envId);
---
{enabled ? (
  <div id="comments" class="cf" data-pagefind-ignore data-twikoo-env={envId}>
    <h1 class="comment-title">评论</h1>
    <div id="tcomment"></div>
  </div>
) : (
  <div>
    <h3>评论区已关闭</h3>
  </div>
)}
