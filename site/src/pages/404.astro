---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout pageType="page" navCurrent="/404" title="页面未找到">
  <meta slot="head" name="robots" content="noindex, nofollow" />
  <div class="wrapper">
    <article class="post post--text post--index main-item" data-pagefind-ignore>
      <div class="post-inner">
        <section class="post-item post-body is-tight-top">
          <div class="wrapper post-wrapper not-found-card">
            <svg class="not-found-illustration" viewBox="0 0 160 120" fill="none" aria-hidden="true">
              <path d="M43 12h50l24 24v57H43z" fill="var(--card2-color)" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
              <path d="M93 12v24h24M58 49h43M58 61h30M58 73h22" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              <circle cx="108" cy="84" r="19" fill="var(--card-color)" stroke="var(--themecolor)" stroke-width="3" />
              <path d="m122 98 15 15" stroke="var(--themecolor)" stroke-width="4" stroke-linecap="round" />
            </svg>
            <p class="not-found-code">404</p>
            <h1 class="not-found-title">页面走丢了</h1>
            <p class="not-found-description">你访问的页面不存在、已删除，或链接地址有误。</p>
            <nav class="not-found-actions" aria-label="继续浏览">
              <a href="/" class="not-found-action">返回首页</a>
              <a href="/search" class="not-found-action not-found-action-secondary">搜索文章</a>
            </nav>
          </div>
        </section>
      </div>
    </article>
  </div>
</BaseLayout>
