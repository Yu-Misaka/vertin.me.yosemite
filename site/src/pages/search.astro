---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../config/site";
---
<BaseLayout pageType="list" navCurrent="/search" title="搜索">
  <Fragment slot="head">
    <link rel="stylesheet" href="/css/pagefind-theme.css" />
  </Fragment>

  <div class="wrapper">
    <h3 class="archive-title ps-enter-hidden-list" id="search-title">搜索</h3>
    <div
      class="search-page"
      id="search-page"
      data-author-name={site.author.name}
      data-author-avatar={site.author.avatar}
      data-show-category={site.show.cardCategory ? "1" : "0"}
    >
      <form class="search-container" id="search-form" role="search">
        <input
          type="text"
          name="q"
          class="search-input"
          id="search-input"
          placeholder="输入关键字搜索"
          aria-label="输入关键字搜索"
          autocapitalize="none"
          enterkeyhint="search"
        />
        <button type="submit" class="search-button" aria-label="搜索">
          <span class="icon-search"></span>
        </button>
      </form>
      <p class="search-message" id="search-message"></p>
      <div class="search-results" id="search-results"></div>
    </div>
  </div>

  <nav class="nav main-pager ps-enter-hidden-list" data-js="pager" data-swup-animation>
    <span class="nav-item-alt">第 1 页 / 共 1 页</span>
    <div class="nav nav--pager">
      <i class="icon-record-outline"></i>
    </div>
  </nav>

  <div class="nav main-lastinfo ps-enter-hidden-list">
    <span class="nav-item-alt" set:html={site.footerInfo} />
  </div>
</BaseLayout>
