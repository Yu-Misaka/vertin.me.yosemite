---
import { getCollection } from "astro:content";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import { site } from "../../../../config/site";
import PostList from "../../../../components/PostList.astro";

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  const pageSize = site.postsPerPage ?? 10;
  const categoryMap = new Map<string, { name: string; count: number }>();

  posts.forEach((post) => {
    if (!post.data.category) return;
    const name = post.data.category.trim();
    if (!name) return;
    const entry = categoryMap.get(name) ?? { name, count: 0 };
    entry.count += 1;
    categoryMap.set(name, entry);
  });

  const paths: Array<{ params: { category: string; page: string }; props: { category: string } }> = [];
  for (const [slug, entry] of categoryMap.entries()) {
    const totalPages = Math.max(1, Math.ceil(entry.count / pageSize));
    for (let page = 2; page <= totalPages; page += 1) {
      paths.push({ params: { category: slug, page: String(page) }, props: { category: entry.name } });
    }
  }

  return paths;
}

const { category } = Astro.props;
const categorySlug = encodeURIComponent(category ?? "");
const pageNumber = Number(Astro.params.page);
const currentPage = Number.isFinite(pageNumber) && pageNumber > 1 ? pageNumber : 2;

const posts = await getCollection("posts", ({ data }) => !data.draft);
const filtered = posts
  .filter((post) => post.data.category?.trim() === category)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const pageSize = site.postsPerPage ?? 10;
const totalPages = Math.max(1, Math.ceil(filtered.length / pageSize));
const safePage = Math.min(currentPage, totalPages);
const start = (safePage - 1) * pageSize;
const pagePosts = filtered.slice(start, start + pageSize);

const prevUrl =
  safePage <= 1
    ? null
    : safePage === 2
      ? `/categories/${categorySlug}/`
      : `/categories/${categorySlug}/page/${safePage - 1}/`;
const nextUrl = safePage < totalPages ? `/categories/${categorySlug}/page/${safePage + 1}/` : null;
---
<BaseLayout pageType="list" navCurrent="/" title={`分类 ${category}`}>
  <div class="wrapper">
    <h3 class="archive-title">分类 {category} 下的文章</h3>

    <PostList
      posts={pagePosts}
      currentPage={safePage}
      totalPages={totalPages}
      prevUrl={prevUrl}
      nextUrl={nextUrl}
    />
  </div>
</BaseLayout>
