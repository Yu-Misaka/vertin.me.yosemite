---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { site } from "../../config/site";
import PostList from "../../components/PostList.astro";

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  const categoryMap = new Map<string, string>();
  posts.forEach((post) => {
    if (post.data.category) {
      const name = post.data.category.trim();
      if (!name) return;
      categoryMap.set(name, name);
    }
  });

  return Array.from(categoryMap.entries()).map(([slug, name]) => ({
    params: { category: slug },
    props: { category: name }
  }));
}

const { category } = Astro.props;
const categorySlug = encodeURIComponent(category ?? "");
const posts = await getCollection("posts", ({ data }) => !data.draft);
const filtered = posts
  .filter((post) => post.data.category?.trim() === category)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const pageSize = site.postsPerPage ?? 10;
const totalPages = Math.max(1, Math.ceil(filtered.length / pageSize));
const currentPage = 1;
const pagePosts = filtered.slice(0, pageSize);
const prevUrl = null;
const nextUrl = currentPage < totalPages ? `/categories/${categorySlug}/page/${currentPage + 1}/` : null;
---
<BaseLayout pageType="list" navCurrent="/" title={`分类 ${category}`}>
  <div class="wrapper">
    <h3 class="archive-title">分类 {category} 下的文章</h3>

    {pagePosts.length ? (
      <PostList
        posts={pagePosts}
        currentPage={currentPage}
        totalPages={totalPages}
        prevUrl={prevUrl}
        nextUrl={nextUrl}
      />
    ) : (
      <article class="post post--text post--index main-item ps-enter-hidden-list" data-swup-animation>
        <div class="post-inner">
          <section class="post-item post-body is-tight-top">
            <div class="wrapper post-wrapper">
              <p class="is-centered">
                <img src="/images/Zai_Cry.png" id="ZaiJPG" alt="没有适合的结果" class="empty-state-image" />
              </p>
              <p class="is-centered">肥肠抱歉，没有找到适合的结果( ´ﾟДﾟ`)</p>
              <p class="is-centered">不妨在本站到处逛逛？</p>
            </div>
          </section>
        </div>
      </article>
    )}
  </div>
</BaseLayout>
