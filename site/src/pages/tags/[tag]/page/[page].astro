---
import { getCollection } from "astro:content";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import { site } from "../../../../config/site";
import PostList from "../../../../components/PostList.astro";

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  const pageSize = site.postsPerPage ?? 10;
  const tagMap = new Map<string, { name: string; count: number }>();

  posts.forEach((post) => {
    (post.data.tags ?? []).forEach((tag) => {
      const name = tag.trim();
      if (!name) return;
      const entry = tagMap.get(name) ?? { name, count: 0 };
      entry.count += 1;
      tagMap.set(name, entry);
    });
  });

  const paths: Array<{ params: { tag: string; page: string }; props: { tag: string } }> = [];
  for (const [slug, entry] of tagMap.entries()) {
    const totalPages = Math.max(1, Math.ceil(entry.count / pageSize));
    for (let page = 2; page <= totalPages; page += 1) {
      paths.push({ params: { tag: slug, page: String(page) }, props: { tag: entry.name } });
    }
  }

  return paths;
}

const { tag } = Astro.props;
const tagSlug = encodeURIComponent(tag ?? "");
const pageNumber = Number(Astro.params.page);
const currentPage = Number.isFinite(pageNumber) && pageNumber > 1 ? pageNumber : 2;

const posts = await getCollection("posts", ({ data }) => !data.draft);
const filtered = posts
  .filter((post) => (post.data.tags ?? []).some((entry) => entry.trim() === tag))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const pageSize = site.postsPerPage ?? 10;
const totalPages = Math.max(1, Math.ceil(filtered.length / pageSize));
const safePage = Math.min(currentPage, totalPages);
const start = (safePage - 1) * pageSize;
const pagePosts = filtered.slice(start, start + pageSize);

const prevUrl =
  safePage <= 1
    ? null
    : safePage === 2
      ? `/tags/${tagSlug}/`
      : `/tags/${tagSlug}/page/${safePage - 1}/`;
const nextUrl = safePage < totalPages ? `/tags/${tagSlug}/page/${safePage + 1}/` : null;
---
<BaseLayout pageType="list" navCurrent="/" title={`标签 ${tag}`}>
  <div class="wrapper">
    <h3 class="archive-title">标签 {tag} 下的文章</h3>

    <PostList
      posts={pagePosts}
      currentPage={safePage}
      totalPages={totalPages}
      prevUrl={prevUrl}
      nextUrl={nextUrl}
    />
  </div>
</BaseLayout>
