---
import { getCollection, render } from "astro:content";
import Cover from "../components/Cover.astro";
import AnchorsGallery from "../components/AnchorsGallery.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../config/site";
import Comments from "../components/Comments.astro";
import { buildTocHtml } from "../utils/toc";

export async function getStaticPaths() {
  const pages = await getCollection("pages");
  return pages.map((page) => ({ params: { slug: page.id }, props: { page } }));
}

const { page } = Astro.props;
const { Content, headings } = await render(page);

const hasImg = Boolean(page.data.cover);
const gallery = page.data.gallery ?? [];
// The anchors page is a gallery: its cover opens the room and each exhibit
// carries its own track. The room begins at the cover, so the first exhibit
// has to be the cover itself, and a room needs somewhere to walk.
const isAnchors =
  page.id === "anchors" && gallery.length > 1 && gallery[0]?.image === page.data.cover;

// CV sections live in separate tabs, so a shared TOC would link to hidden content.
const isCv = page.id === "curriculum-vitae";
const tocHtml = isCv ? "" : buildTocHtml(headings);
---
<BaseLayout pageType="page" navCurrent={`/${page.id}`} title={page.data.title} tocHtml={tocHtml}>
  <div class="wrapper">
    <article class={`post ${hasImg ? "post--photo post--cover" : "post--text"} post--index main-item`}>
      <div class="post-inner">
        <header class={`post-item post-header ${hasImg ? "no-bg" : ""}`}>
          <div class="wrapper post-wrapper">
            <div class="avatar post-author">
              <img src={site.author.avatar} alt="作者头像" class="avatar-item avatar-img" width="32" height="32" />
              <span class="avatar-item">{site.author.name}</span>
            </div>
          </div>
        </header>

        {hasImg ? (
          <Cover
            src={page.data.cover!}
            eager
            interactive={isAnchors}
            alt={gallery[0]?.title ?? "头图"}
          />
        ) : null}

        <section class="post-item post-body">
          <div class="wrapper post-wrapper">
            <h1 class="post-title">
              <a href={`/${page.id}/`} title={page.data.title}>
                {page.data.title}
              </a>
            </h1>
            <div class="inner-post-wrapper">
              <div class="meta post-meta">
                <a href={`/${page.id}/`} class="icon-ui icon-ui-date meta-item meta-date">
                  <span class="meta-count">{page.data.date ? page.data.date.toISOString().slice(0, 10) : ""}</span>
                </a>
                <a href={`/${page.id}/#comments`} class="icon-ui icon-ui-comment meta-item meta-comment">
                  暂无评论
                </a>
              </div>

              <!-- The CV is written in English: lang drives hyphenation and Latin typography. -->
              <div class:list={["post-content", { "post-content--cv": isCv }]} lang={isCv ? "en" : undefined} data-pagefind-body>
                <Content />
              </div>
            </div>
          </div>
        </section>

        <section class="post-item post-comments">
          <div class="wrapper post-wrapper">
            <Comments />
          </div>
        </section>
      </div>
    </article>
  </div>

  {isAnchors ? <AnchorsGallery items={gallery} /> : null}

  <nav class="nav main-pager" role="navigation" aria-label="Pagination" data-js="pager">
    <div class="nav main-lastinfo">
      <span class="nav-item-alt" set:html={site.footerInfo} />
    </div>
  </nav>
</BaseLayout>
