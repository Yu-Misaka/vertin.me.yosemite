---
import Header from "../components/Header.astro";
import Sidebar from "../components/Sidebar.astro";
import Footer from "../components/Footer.astro";
import { site } from "../config/site";
import { getThemeTokens } from "../config/theme";
import SpeedInsights  from "@vercel/speed-insights/astro";
import Analytics from '@vercel/analytics/astro';
import { ClientRouter } from "astro:transitions";
import serifLatin from '@fontsource-variable/source-serif-4/files/source-serif-4-latin-wght-normal.woff2?url';
import '../styles/fonts.css';
import '../styles/theme.css';
import '../styles/components.css';
import '../styles/notifications.css';
import '../styles/motion.css';
import 'katex/dist/katex.min.css';
import 'aplayer/dist/APlayer.min.css';
import 'virtual:site-fonts.css';

const title = Astro.props.title;
const description = Astro.props.description ?? site.description;
const pageType = Astro.props.pageType ?? "list";
const navCurrent = Astro.props.navCurrent ?? "/";
const tocHtml = Astro.props.tocHtml ?? "";

const themeTokens = getThemeTokens(site.themeColor);
const pageTitle = title ? `${title} - ${site.title}` : site.title;

const twikooEnvId = site.comments?.provider === "twikoo" ? site.comments.envId : "";
---
<!DOCTYPE html>
<html lang="zh-CN" data-twikoo-env={twikooEnvId || undefined} data-post-title-after={site.postTitleAfter}>
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="renderer" content="webkit" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <slot name="head" />


    <style
      is:inline
      set:html={`:root{--themecolor:${themeTokens.light.theme};--themehovercolor:${themeTokens.light.hover};}
      [data-theme="dark"]{--themecolor:${themeTokens.dark.theme};--themehovercolor:${themeTokens.dark.hover};}`}
    />

    <script is:inline>
      (() => {
        let saved = 'dark';
        try {
          saved = document.cookie.match(/(?:^|;)\s*theme=([^;]+)/)?.[1] || localStorage.getItem('theme') || 'dark';
        } catch {}
        document.documentElement.dataset.theme = saved === 'auto'
          ? (matchMedia('(prefers-color-scheme:dark)').matches ? 'dark' : 'light')
          : saved;
      })();
    </script>
    <link rel="stylesheet" href="/css/fontello.css" />
    <link rel="preload" href={serifLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.webp" type="image/webp" />
    <style is:inline id="twikoo-styles" data-astro-transition-persist="twikoo-styles"></style>


    <!-- medium-zoom CSS (included statically to persist across view transitions) -->
    <style is:inline>
      .medium-zoom-overlay{position:fixed;top:0;right:0;bottom:0;left:0;opacity:0;transition:opacity var(--motion-page) var(--motion-ease);will-change:opacity}
      .medium-zoom--opened .medium-zoom-overlay{cursor:pointer;cursor:zoom-out;opacity:1}
      .medium-zoom-image{cursor:pointer;cursor:zoom-in;transition:transform var(--motion-page) var(--motion-ease)!important}
      .medium-zoom-image--hidden{visibility:hidden}
      .medium-zoom-image--opened{position:relative;cursor:pointer;cursor:zoom-out;will-change:transform}
    </style>

    <ClientRouter fallback="swap" />
    <script>
      import '../scripts/app.js';
    </script>
  </head>
  <body>
    <div class="wrapper">
      <Header current={navCurrent} />
      <div id="page-content" data-ps-page-type={pageType} data-nav-current={navCurrent}>
        <main class="main" transition:name="content">
          <slot />
        </main>
        <Sidebar tocHtml={tocHtml} />
      </div>
      <Footer />
    </div>
    <SpeedInsights />
    <Analytics />
  </body>
</html>
