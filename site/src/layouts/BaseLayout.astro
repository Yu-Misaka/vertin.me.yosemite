---
import Header from "../components/Header.astro";
import Sidebar from "../components/Sidebar.astro";
import Footer from "../components/Footer.astro";
import { site } from "../config/site";
import { getThemeTokens } from "../config/theme";
import SpeedInsights  from "@vercel/speed-insights/astro";
import Analytics from '@vercel/analytics/astro';
import { ClientRouter } from "astro:transitions";

const title = Astro.props.title;
const description = Astro.props.description ?? site.description;
const pageType = Astro.props.pageType ?? "list";
const navCurrent = Astro.props.navCurrent ?? "/";
const tocHtml = Astro.props.tocHtml ?? "";

const themeTokens = getThemeTokens(site.themeColor);
const pageTitle = title ? `${title} - ${site.title}` : site.title;

const twikooEnvId = site.comments?.provider === "twikoo" ? site.comments.envId : "";
---
<!DOCTYPE html>
<html lang="zh-CN" data-twikoo-env={twikooEnvId || undefined}>
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="renderer" content="webkit" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <slot name="head" />

    <link rel="preconnect" href="https://cdn.academe.city" crossorigin />
    <link rel="preconnect" href="https://mirrors.sustech.edu.cn" crossorigin />

    <style
      is:inline
      set:html={`:root{--themecolor:${themeTokens.light.theme};--themehovercolor:${themeTokens.light.hover};}
      [data-theme="dark"]{--themecolor:${themeTokens.dark.theme};--themehovercolor:${themeTokens.dark.hover};}`}
    />

    <script is:inline>
      window.THEME_URL = "";
    </script>

    <script is:inline data-page-type={pageType}>
      (function () {
        const scriptEl = document.currentScript;
        const pageType = scriptEl instanceof HTMLScriptElement ? scriptEl.dataset.pageType : null;

        const cookieMatch = document.cookie.match(/(?:^|;)\s*theme=([^;]+)/);
        const cookieTheme = cookieMatch ? cookieMatch[1] : null;
        const localTheme = localStorage.getItem("theme");
        let initialTheme = cookieTheme || localTheme || "auto";
        if (initialTheme === "auto") {
          initialTheme = window.matchMedia("(prefers-color-scheme:dark)").matches ? "dark" : "light";
        }
        document.documentElement.setAttribute("data-theme", initialTheme);
        try {
          if (window.matchMedia && !window.matchMedia("(prefers-reduced-motion:reduce)").matches) {
            document.documentElement.classList.add(
              pageType === "post"
                ? "ps-preload-post-enter"
                : pageType === "page"
                  ? "ps-preload-page-enter"
                  : "ps-preload-list-enter"
            );
          }
        } catch (e) {}
      })();
    </script>

    <link rel="preload" href="/css/PureSuck_Style.css" as="style" />
    <link rel="stylesheet" href="/css/PureSuck_Style.css" />

    <link rel="preload" href="/css/fontello.css" as="style" />
    <link rel="stylesheet" href="/css/fontello.css" />

    <link rel="icon" href="/favicon.webp" type="image/x-icon" />

    <link rel="stylesheet" href="/css/PureSuck_Module.css" />
    <link rel="stylesheet" href="/css/MoxDesign.css" />
    <link rel="stylesheet" href="/css/animations/index.css" />
    <link rel="stylesheet" href="/fonts/result.css" />
    <link rel="stylesheet" href="/css/APlayer.min.css" />
    <link rel="stylesheet" href="https://mirrors.sustech.edu.cn/cdnjs/ajax/libs/KaTeX/0.16.9/katex.min.css" />

    <!-- medium-zoom CSS (included statically to persist across view transitions) -->
    <style is:inline>
      .medium-zoom-overlay{position:fixed;top:0;right:0;bottom:0;left:0;opacity:0;transition:opacity .3s;will-change:opacity}
      .medium-zoom--opened .medium-zoom-overlay{cursor:pointer;cursor:zoom-out;opacity:1}
      .medium-zoom-image{cursor:pointer;cursor:zoom-in;transition:transform .3s cubic-bezier(.2,0,.2,1)!important}
      .medium-zoom-image--hidden{visibility:hidden}
      .medium-zoom-image--opened{position:relative;cursor:pointer;cursor:zoom-out;will-change:transform}
    </style>

    {site.postTitleAfter !== "off" ? (
      <style
        is:inline
        set:html={`.post-title::after{content:"";bottom:${site.postTitleAfter === "wavyLine" ? "-5px" : "5px"};left:0;${
          site.postTitleAfter === "boldLine"
            ? "width:58px;height:11px;"
            : site.postTitleAfter === "wavyLine"
              ? "width:106px;height:12px;mask:url('data:image/svg+xml;utf8,<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"40\" height=\"10\" viewBox=\"0 0 40 10\" preserveAspectRatio=\"none\"><path d=\"M0 5 Q 10 0, 20 5 T 40 5\" stroke=\"black\" stroke-width=\"2\" fill=\"transparent\"/></svg>') repeat-x;mask-size:40px 12px;"
              : ""
        }}`}
      />
    ) : null}

    <script defer src="/js/lib/medium-zoom.min.js"></script>
    <script defer src="/js/PureSuck_Shortcodes.js"></script>
    <script defer src="/js/PureSuck_Module.js"></script>
    <script defer src="/js/MoxDesign.js"></script>
    <script defer src="/js/PureSuck_LazyLoad.js"></script>
    <script defer src="/js/PureSuck_Pagefind.js"></script>
    <script defer src="/js/PureSuck_Twikoo.js"></script>
    <script defer src="/js/PureSuck_ViewTransitions.js"></script>
    <script defer src="/js/PureSuck_APlayer.js"></script>
    <script defer src="/js/PureSuck_Fallback.js"></script>

    <ClientRouter />

    <script defer src="https://mirrors.sustech.edu.cn/cdnjs/ajax/libs/KaTeX/0.16.9/katex.min.js"></script>
    <script defer src="https://mirrors.sustech.edu.cn/cdnjs/ajax/libs/KaTeX/0.16.9/contrib/auto-render.min.js"></script>
    <script src="https://mirrors.sustech.edu.cn/cdnjs/ajax/libs/aplayer/1.10.1/APlayer.min.js"></script>

    <script defer type="text/javascript">
      function renderLatex() {
        if (typeof renderMathInElement !== "undefined") {
          renderMathInElement(document.body, {
            delimiters: [
              { left: "$$", right: "$$", display: true },
              { left: "$", right: "$", display: false }
            ],
            ignoredTags: ["script", "noscript", "style", "textarea", "pre", "code"],
            ignoredClasses: ["nokatex"]
          });
        }
      }

      window.renderLatex = renderLatex;

      document.addEventListener("DOMContentLoaded", function () {
        renderLatex();
      });

      document.addEventListener("astro:after-swap", function () {
        renderLatex();
      });
    </script>

    <script is:inline>
      document.addEventListener("astro:page-load", () => {
        if (sessionStorage.getItem("mox_greeted")) return;
        sessionStorage.setItem("mox_greeted", "1");

        const now = new Date();
        const hour = now.getHours();
        const timeStr = now.toLocaleString();

        let greeting = "你好！";
        if (hour < 6) greeting = "夜深了";
        else if (hour < 12) greeting = "早上好";
        else if (hour < 18) greeting = "下午好";
        else greeting = "晚上好";

        MoxNotification({
          title: greeting,
          duration: 5000,
          message: "欢迎访问本站。<br>当前时间：" + timeStr
        });
      });
    </script>
  </head>
  <body>
    <div class="wrapper">
      <Header current={navCurrent} />
      <div id="swup" data-ps-page-type={pageType}>
        <main class="main">
          <slot />
        </main>
        <Sidebar tocHtml={tocHtml} />
      </div>
      <Footer />
    </div>
    <SpeedInsights />
    <Analytics />
  </body>
</html>
